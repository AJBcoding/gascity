#!/usr/bin/env bash
set -euo pipefail

# Heavy `go test` fan-out runs here, at push time, instead of on every commit
# (#3628). pre-commit previously invoked `make test-fast-parallel` on every
# commit. Its outer shard fan-out can compile ~2.8 GiB test binaries per job,
# so the canonical runner now derives concurrency from both CPU and available
# memory while preserving an explicit LOCAL_TEST_JOBS override. Running the
# suite at push time also fires it only when Go sources actually change.
#
# git feeds "<local ref> <local sha> <remote ref> <remote sha>" per pushed ref
# on stdin (see githooks(5)).

zero="0000000000000000000000000000000000000000"

# git passes the remote's name as $1 (or its URL when pushing by URL); the
# new-branch base search below scopes to that remote's tracking refs. Empty
# only if the hook is invoked outside git, which keeps the conservative path.
remote="${1:-}"

go_changed=0
pushed_refs=""   # "<local ref> <local sha>" per line, non-deletions only
any_non_deletion=0
pushed_count=0
scope_base=""    # last non-deletion remote sha; only used when exactly one ref
scope_tip=""     # last non-deletion local sha; likewise
while read -r local_ref local_sha _remote_ref remote_sha; do
  # Branch deletion — nothing to test, nothing to guard.
  if [ "$local_sha" = "$zero" ]; then
    continue
  fi
  any_non_deletion=1
  pushed_refs="${pushed_refs}${local_ref} ${local_sha}
"
  # scope_base deliberately keeps the PRE-recovery remote sha: for a first
  # push it stays the zero sentinel, so the affected-package scoping below
  # still falls back to the full suite. Scoping from the recovered ancestor
  # base is gas-mnpr item 2's composition, kept out of this merge on purpose.
  pushed_count=$((pushed_count + 1))
  scope_base="$remote_sha"
  scope_tip="$local_sha"
  # New remote branch: the remote has no counterpart ref, but it almost always
  # has SOME shared history, and the nearest ancestor it already carries is a
  # correct, cheap diff base — this is what makes a docs-only or scripts-only
  # first push a non-event instead of a full-suite run (gas-mnpr part 1;
  # gas-2uct and gas-9f29 each needed a --no-verify conversation for exactly
  # this line). Boundary commits of `rev-list <tip> --not --remotes=<remote>`
  # are that frontier: parents of pushed commits the remote provably has, so a
  # tree diff from one of them can over-test but never under-test the push.
  # Empty output means the remote already has every pushed commit under some
  # other ref — nothing new to test. New commits with NO boundary means no
  # shared history at all (root graft): keep the conservative full-suite run.
  if [ "$remote_sha" = "$zero" ]; then
    if [ -z "$remote" ]; then
      go_changed=1
      continue
    fi
    reachable="$(git rev-list --boundary --topo-order "$local_sha" --not --remotes="$remote" 2>/dev/null || true)"
    if [ -z "$reachable" ]; then
      continue
    fi
    base="$(printf '%s\n' "$reachable" | sed -n 's/^-//p' | head -n 1)"
    if [ -z "$base" ]; then
      go_changed=1
      continue
    fi
    remote_sha="$base"
  fi
  if git diff --name-only "$remote_sha" "$local_sha" -- '*.go' 2>/dev/null | grep -q .; then
    go_changed=1
  fi
done

# Bead ownership/staleness guard (ga-fip9ps.1): re-checks bd claim state
# immediately before this push leaves the machine, once per invocation
# (not per ref) regardless of whether Go sources changed. A mayor ruling
# (reassign/close/hold/reroute) that landed after this push was queued
# must not be allowed to clobber a branch another agent has since taken
# over. Bypass: `git push --no-verify`.
if [ "$any_non_deletion" -eq 1 ]; then
  repo_root="$(git rev-parse --show-toplevel)"
  # shellcheck source=../scripts/push-ownership-guard.sh disable=SC1091
  . "$repo_root/scripts/push-ownership-guard.sh"
  if ! assert_bead_still_claimed; then
    exit 1
  fi
fi

if [ "$go_changed" -eq 0 ]; then
  exit 0
fi

# Wrong-worktree guard (gas-4pz): the suite below tests the CHECKED-OUT tree,
# so a push run from a worktree parked on another branch (e.g. the repo root
# on the deploy branch) produces a verdict about that branch and silently
# attributes it to the pushed ref — that is how a fork-local test failure on
# the parked deploy branch got a healthy fix branch's push filed as
# "origin/main is RED". Require the tested HEAD to be contained in (ancestor
# of, or equal to) at least one ref this push is sending; a HEAD behind the
# pushed ref can under-test new commits, but it can never attribute a failure
# from a tree the push does not contain. Bypass: `git push --no-verify`.
head_sha="$(git rev-parse HEAD)"
head_name="$(git rev-parse --abbrev-ref HEAD)"
head_short="$(git rev-parse --short HEAD)"
worktree="$(git rev-parse --show-toplevel)"
head_in_push=0
while read -r ref sha; do
  [ -n "$ref" ] || continue
  if git merge-base --is-ancestor "$head_sha" "$sha" 2>/dev/null; then
    head_in_push=1
    break
  fi
done <<EOF
$pushed_refs
EOF

if [ "$head_in_push" -eq 0 ]; then
  {
    echo "pre-push: REFUSING to run the test gate from this worktree."
    echo "pre-push: it has ${head_name}@${head_short} checked out ($worktree),"
    echo "pre-push: which is not contained in any ref this push is sending:"
    while read -r ref sha; do
      [ -n "$ref" ] || continue
      echo "pre-push:   ${ref}@$(git rev-parse --short "$sha")"
    done <<EOF
$pushed_refs
EOF
    echo "pre-push: a verdict from this tree would be about ${head_name}, not the pushed ref (gas-4pz)."
    echo "pre-push: run the push from the worktree that has the pushed branch checked out"
    echo "pre-push: (see: git worktree list), or bypass consciously with: git push --no-verify"
  } >&2
  exit 1
fi

# Disk preflight (gas-wnq / gas-9nx): the fan-out below compiles multi-GiB test
# binaries per job, so it is one of the largest disk consumers on the host. When
# it hits ENOSPC partway through, it does not fail as "out of disk" — it fails as
# an inscrutable build or link error, or the agent running it parks at a prompt
# it cannot get past. That is the shape of the original incident: a polecat
# committed its fix, could not push, and from outside was indistinguishable from
# a hung session for an hour while holding a pool slot.
#
# Refuse up front with the actual number instead. Fails open on a probe that
# cannot answer, matching the session-spawn preflight in internal/session: a
# check that cannot measure the disk must never be why a push stops working.
#
# The floor is evidence-backed rather than round: the incident host had 6.9 GiB
# free and that was NOT enough. Override with GC_PREPUSH_MIN_FREE_GIB; 0 disables.
min_free_gib="${GC_PREPUSH_MIN_FREE_GIB:-10}"
if [ "$min_free_gib" != "0" ]; then
  # -P for POSIX single-line output, -k for KiB units: portable across the
  # macOS and Linux hosts this repo builds on. The `|| true` is load-bearing:
  # this script runs under `set -euo pipefail`, so without it a df that cannot
  # stat the worktree aborts the hook and REFUSES the push — the exact opposite
  # of the fail-open contract documented above.
  free_kib="$(df -Pk "$worktree" 2>/dev/null | awk 'NR==2 {print $4}' || true)"
  if [ -n "$free_kib" ] && [ "$free_kib" -eq "$free_kib" ] 2>/dev/null; then
    min_free_kib=$((min_free_gib * 1024 * 1024))
    if [ "$free_kib" -lt "$min_free_kib" ]; then
      {
        echo "pre-push: REFUSING to run the test gate: not enough free disk."
        echo "pre-push:   $((free_kib / 1024 / 1024)) GiB free on $worktree, floor ${min_free_gib} GiB."
        echo "pre-push: the sharded suite compiles multi-GiB test binaries per job; starting it"
        echo "pre-push: here would fail partway through as a build error, not as 'disk full' (gas-wnq)."
        echo "pre-push: free space, then retry. To lower the floor: GC_PREPUSH_MIN_FREE_GIB=<n> git push"
        echo "pre-push: (0 disables). To skip the gate entirely: git push --no-verify"
      } >&2
      exit 1
    fi
  else
    echo "pre-push: disk pre-flight could not read df for $worktree (fail-open); continuing" >&2
  fi
fi

# Verdict header (gas-4pz): name the tree the suite actually tests so a
# misattributed verdict is visible in the output instead of invisible.
echo "pre-push: testing ${head_name}@${head_short} ($worktree) for push of:"
while read -r ref sha; do
  [ -n "$ref" ] || continue
  echo "pre-push:   ${ref}@$(git rev-parse --short "$sha")"
done <<EOF
$pushed_refs
EOF

# Affected-package scoping (gas-qnav): the range decided WHETHER to run; let
# it decide WHAT to run too. scripts/ci-static-select already walks the real
# build-input graph — the same engine `make lint-affected` uses — so the gate
# asks it which packages the pushed range affects instead of paying for all
# ~179 on any .go change. The whole-repository suite still runs, once, at the
# batch/landing gate (`make test-local-full-parallel`), which cannot be scoped
# from the environment.
#
# Narrowing is only sound when the tree the suite tests IS the tree being
# pushed. Anything else falls back to the full suite: this gate must fail
# toward more testing, never less.
scope="./..."
scope_reason=""
selector="$worktree/scripts/ci-static-select"
if [ "$pushed_count" -ne 1 ]; then
  scope_reason="pushing ${pushed_count} refs, so no single tested tree to scope from"
elif [ "$scope_base" = "$zero" ]; then
  scope_reason="new remote branch, so no base to diff against"
elif [ "$scope_tip" != "$head_sha" ]; then
  scope_reason="tested tree ${head_short} is not the pushed tip"
elif [ ! -x "$selector" ]; then
  scope_reason="scripts/ci-static-select is not available here"
else
  # `|| true` is load-bearing under `set -e`: a selector that cannot answer
  # must widen the scope, not abort the push. The selector prints ./... for a
  # set it cannot compute, so an empty answer means it found no Go build
  # inputs at all — which contradicts the range check above, so widen too.
  affected="$(
    LINT_CHANGED_SCOPE=tracked LINT_CHANGED_REF="$scope_base" \
      "$selector" list-affected go 2>/dev/null || true
  )"
  if [ -n "$affected" ]; then
    scope="$(printf '%s\n' "$affected" | tr '\n' ' ' | sed 's/[[:space:]]*$//')"
  else
    scope_reason="the selector could not narrow the pushed range"
  fi
fi

if [ "$scope" = "./..." ]; then
  echo "pre-push: scope: whole repository${scope_reason:+ (${scope_reason})}"
else
  echo "pre-push: scope: ${scope}"
fi
export LOCAL_TEST_PACKAGES="$scope"

# The Makefile and direct sharded runner share scripts/test-local-job-count as
# their default policy. Do not shadow it here; an explicit override still wins.
exec make test-fast-parallel
